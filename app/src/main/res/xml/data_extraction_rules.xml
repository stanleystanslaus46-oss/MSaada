<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Restore the user's offline MSAADA database and preferences. -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="msaada_app_preferences.xml" />
        <exclude domain="cache" path="." />
        <exclude domain="no_backup" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Preserve the same user state during device-to-device transfer. -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="msaada_app_preferences.xml" />
        <exclude domain="cache" path="." />
        <exclude domain="no_backup" path="." />
    </device-transfer>
</data-extraction-rules>
