# Android release build-time configuration
# Example only; do not commit secrets.
MSAADA_BILLING_API_URL=https://YOUR-NETLIFY-SITE.netlify.app/.netlify/functions/verify-subscription

# Netlify backend secrets (configure in Netlify UI, not Android source)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={...}
# MSAADA_PACKAGE_NAME=com.aistudio.msaada.tzapp

# MSAADA manual payment notification
MSAADA_PAYMENT_API_URL=https://YOUR-NETLIFY-SITE.netlify.app/api/submit-payment
MSAADA_PAYMENT_NUMBER=+255742259683

# Netlify/Twilio secrets (never put these in Android source)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:
MSAADA_SMS_TO=+255650039639
MSAADA_WHATSAPP_TO=+255742259683

# MSAADA PRO activation
MSAADA_ACTIVATION_API_URL=https://YOUR-NETLIFY-SITE.netlify.app/api/redeem-pro
MSAADA_ADMIN_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
